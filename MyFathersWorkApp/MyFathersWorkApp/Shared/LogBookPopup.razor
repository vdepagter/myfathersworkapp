@inject AudioService Audio

@* Log Book (Shared/LogBook.cs): the logged events, six per page and oldest first as in the official app (ViewLogBook.cs),
   on Unity's open book (New_UI_Assets/LogBook): three events on each page, page arrows and the red close button. Narrow
   windows get one tall page. *@
@if (Visible)
{
    string previous = GlobalData.GetLocalizedUITag(GlobalTags.LogBook_Previous);
    string next     = GlobalData.GetLocalizedUITag(GlobalTags.LogBook_Next);
    string close    = GlobalData.GetLocalizedUITag(GlobalTags.LogBook_Close);
    List<LogBookEntry> shown = Entries.Skip(_Page * _PAGE_SIZE).Take(_PAGE_SIZE).ToList();

    <div class="logbook-overlay" @onclick="Close">
        <div class="logbook-wrap mfw-zoom-in" @onclick:stopPropagation="true">
            <h2 class="logbook-title">@GlobalData.GetLocalizedUITag(GlobalTags.LogBook_Title)</h2>

            <div class="logbook" role="dialog">
                <button class="logbook-close" @onclick="Close" aria-label="@close" title="@close"></button>

                <div class="logbook-pages">
                    @if (Entries.Count == 0)
                    {
                        <p class="logbook-empty mfw-ink">@GlobalData.GetLocalizedUITag(GlobalTags.LogBook_Empty)</p>
                    }
                    else
                    {
                        @for (int side = 0; side < 2; side++)
                        {
                            <ol class="logbook-entries mfw-ink">
                                @foreach (LogBookEntry entry in shown.Skip(side * _PAGE_SIZE / 2).Take(_PAGE_SIZE / 2))
                                {
                                    <li class="logbook-entry">
                                        <div class="logbook-entry-title">@entry.Title</div>
                                        <div class="logbook-entry-location">@entry.Location</div>
                                        <div class="logbook-entry-summary">@entry.Summary</div>
                                    </li>
                                }
                            </ol>
                        }
                    }
                </div>

                <div class="logbook-nav">
                    <button class="logbook-arrow previous" disabled="@(_Page == 0)" @onclick="Previous" aria-label="@previous" title="@previous"></button>
                    @if (PageCount > 1)
                    {
                        <span class="logbook-page mfw-ink">@GlobalData.GetLocalizedUITag(GlobalTags.LogBook_Page).FormatWithReplacement(0, (_Page + 1).ToString()).FormatWithReplacement(1, PageCount.ToString())</span>
                    }
                    <button class="logbook-arrow" disabled="@(_Page >= PageCount - 1)" @onclick="Next" aria-label="@next" title="@next"></button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool               Visible    { get; set; }
    [Parameter] public List<LogBookEntry> Entries    { get; set; } = [];
    [Parameter] public GlobalData         GlobalData { get; set; } = null!;
    [Parameter] public EventCallback      OnClose    { get; set; }

    private const int _PAGE_SIZE = 6;

    private int  _Page;
    private bool _WasVisible;

    private int PageCount => Math.Max(1, (Entries.Count + _PAGE_SIZE - 1) / _PAGE_SIZE);

    // Opens on the first page, as Unity did
    protected override void OnParametersSet()
    {
        if (Visible && !_WasVisible) _Page = 0;
        _WasVisible = Visible;
    }

    private void Previous()
    {
        Audio.PlayClick();
        if (_Page > 0) _Page--;
    }

    private void Next()
    {
        Audio.PlayClick();
        if (_Page < PageCount - 1) _Page++;
    }

    private Task Close()
    {
        Audio.PlayClick();
        return OnClose.InvokeAsync();
    }
}
