@implements IDisposable
@inject OfflineService Offline
@inject AudioService   Audio

@* "Play offline" choice on the Main Menu (Pages/Home.razor) right after installing the app, or on its first start as an
   installed app (js/offline.js askNarration): which narration packs to download, all ticked by default. Asked once per
   device (localStorage mfwOfflineAsked); Settings > Play offline changes it later. *@
@if (Offline.State.AskNarration && Audio.Available)
{
    <div class="offline-setup-overlay">
        <div class="offline-setup mfw-dark-panel mfw-appear" role="dialog" aria-labelledby="offline-setup-title">
            <h2 id="offline-setup-title" class="mfw-heading">@T(GlobalTags.OfflineSetup_Title)</h2>
            <p>@T(GlobalTags.OfflineSetup_Text)</p>

            <div class="offline-setup-packs">
                @foreach (OfflinePack pack in Offline.State.Packs.OrderBy(p => p.Order))
                {
                    <label class="setup-option">
                        <input type="checkbox" checked="@Chosen(pack)" @onchange="e => Toggle(pack, e.Value is true)"/>
                        <span>@pack.Name(GlobalData) <small>@OfflinePack.Size(pack.Bytes)</small></span>
                    </label>
                }
            </div>

            <p class="offline-setup-total">
                @T(GlobalTags.OfflineSetup_Total).FormatWithReplacement(0, OfflinePack.Size(SelectedBytes))
                @if (Offline.State.Quota > 0)
                {
                    <br/><small>@T(GlobalTags.OfflineSetup_Space).FormatWithReplacement(0, OfflinePack.Size(Math.Max(0, Offline.State.Quota - Offline.State.Usage)))</small>
                }
            </p>
            <small class="offline-setup-note">@T(GlobalTags.OfflineSetup_Note)</small>

            <div class="offline-setup-buttons">
                <button class="mfw-button green" disabled="@(SelectedBytes == 0)" @onclick="Download">
                    @T(GlobalTags.OfflineSetup_Download)
                </button>
                <button class="mfw-button" @onclick="Later">@T(GlobalTags.OfflineSetup_Later)</button>
            </div>
        </div>
    </div>
}

@code
{
    [Parameter] public GlobalData GlobalData { get; set; } = null!;

    private readonly HashSet<string> _Unticked = new();

    private bool Chosen(OfflinePack pack) => !_Unticked.Contains(pack.Id);

    private long SelectedBytes => Offline.State.Packs.Where(Chosen).Sum(p => p.Bytes);

    private string T(string tag) => GlobalData.GetLocalizedUITag(tag);

    protected override void OnInitialized() => Offline.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Toggle(OfflinePack pack, bool on)
    {
        Audio.PlayClick();
        if (on) _Unticked.Remove(pack.Id);
        else _Unticked.Add(pack.Id);
    }

    private Task Download()
    {
        Audio.PlayClick();
        return Offline.AnswerNarrationAsync(Offline.State.Packs.Where(Chosen).OrderBy(p => p.Order).Select(p => p.Id)).AsTask();
    }

    private Task Later()
    {
        Audio.PlayClick();
        return Offline.AnswerNarrationAsync([]).AsTask();
    }

    public void Dispose() => Offline.Changed -= OnChanged;
}
