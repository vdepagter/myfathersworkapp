@implements IDisposable
@inject OfflineService Offline
@inject AudioService   Audio

@* "Play offline" in Settings (Main Menu): whether the app is cached, Install as an app, and the narration downloads per
   pack (Oliver per scenario, the original male / female recordings). Shared/OfflineService.cs, js/offline.js. Hidden
   where there is no service worker (development build, the Windows download, an old browser). *@
@if (State.Supported)
{
    <div class="mfw-settings-group offline-settings">
        <div class="mfw-setting-group-title">@T(GlobalTags.Offline_Title)</div>

        <p class="offline-status">
            @if (State.ShellProgress is int percent)
            {
                @T(GlobalTags.Offline_Preparing).FormatWithReplacement(0, percent.ToString())
            }
            else if (State.Available)
            {
                <span class="offline-tick">✓</span> <span>@T(GlobalTags.Offline_Ready)</span>
            }
            else
            {
                @T(GlobalTags.Offline_NotYet)
            }
        </p>

        @if (State.Installable)
        {
            <div class="offline-install">
                <button class="mfw-button offline-button" @onclick="Install">@T(GlobalTags.Offline_Install)</button>
                <small>@T(GlobalTags.Offline_InstallDesc)</small>
            </div>
        }
        else if (State.IosHint && !State.Standalone)
        {
            <small class="offline-hint">@T(GlobalTags.Offline_IosHint)</small>
        }

        @if (State.Available && Audio.Available)
        {
            <div class="mfw-setting-group-title offline-subtitle">@T(GlobalTags.Offline_Narration)</div>
            <small class="offline-hint">@T(GlobalTags.Offline_NarrationDesc)</small>

            @if (State.Packs.Count == 0)
            {
                <small class="offline-hint">@T(GlobalTags.Offline_NoPacks)</small>
            }

            @foreach (OfflinePack pack in State.Packs.OrderBy(PackOrder))
            {
                <div class="offline-pack @(pack.Complete ? "done" : null)">
                    <div class="offline-pack-name">
                        <span>@PackName(pack)</span>
                        <small>@PackSize(pack)</small>
                    </div>
                    <div class="offline-pack-actions">
                        @if (pack.Downloading)
                        {
                            <span class="offline-progress" style="--p:@Percent(pack)%">@Percent(pack)%</span>
                            <button class="mfw-button offline-button small" @onclick="() => Offline.CancelAsync(pack.Id)">@T(GlobalTags.Offline_Cancel)</button>
                        }
                        else if (pack.Complete)
                        {
                            <span class="offline-done">✓ @T(GlobalTags.Offline_Downloaded)</span>
                            <button class="mfw-button offline-button small" @onclick="() => Remove(pack)">@T(GlobalTags.Offline_Remove)</button>
                        }
                        else if (!State.Online)
                        {
                            <span class="offline-muted">@T(GlobalTags.Offline_NeedsInternet)</span>
                            @if (pack.StoredFiles > 0)
                            {
                                <button class="mfw-button offline-button small" @onclick="() => Remove(pack)">@T(GlobalTags.Offline_Remove)</button>
                            }
                        }
                        else
                        {
                            <button class="mfw-button green offline-button small" @onclick="() => Download(pack)">
                                @T(pack.StoredFiles > 0 ? GlobalTags.Offline_Resume : GlobalTags.Offline_Download)
                            </button>
                            @if (pack.StoredFiles > 0)
                            {
                                <button class="mfw-button offline-button small" @onclick="() => Remove(pack)">@T(GlobalTags.Offline_Remove)</button>
                            }
                        }
                    </div>
                </div>
            }

            @if (State.Error != "")
            {
                <p class="offline-error" @onclick="() => Offline.DismissErrorAsync()">
                    @T(State.Error == "space" ? GlobalTags.Offline_ErrorSpace : GlobalTags.Offline_ErrorFailed)
                </p>
            }

            @if (StoredTotal > 0)
            {
                <small class="offline-hint">@T(GlobalTags.Offline_Storage).FormatWithReplacement(0, Megabytes(StoredTotal))</small>
            }
        }
    </div>
}

@code
{
    [Parameter] public GlobalData GlobalData { get; set; } = null!;

    private OfflineState State => Offline.State;

    private long StoredTotal => State.Packs.Sum(p => p.StoredBytes);

    private string T(string tag) => GlobalData.GetLocalizedUITag(tag);

    protected override void OnInitialized()
    {
        Offline.Changed += OnChanged;
        _ = Offline.RefreshAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    // Oliver first, by scenario order of the menu, then the original recordings
    private static int PackOrder(OfflinePack pack) => pack.Scenario switch
    {
        "TheCostOfDisease" => 0,
        "FearOfTheUnknown" => 1,
        "ATimeOfWar"       => 2,
        _                  => pack.Voice == "male" ? 10 : 11
    };

    private string PackName(OfflinePack pack) => pack.Voice switch
    {
        "oliver" => T(GlobalTags.Offline_PackOliver).FormatWithReplacement(0, T("Scenario_" + pack.Scenario)),
        "male"   => T(GlobalTags.Offline_PackMale),
        "female" => T(GlobalTags.Offline_PackFemale),
        _        => pack.Id
    };

    private static string PackSize(OfflinePack pack) =>
        pack.StoredFiles > 0 && !pack.Complete ? $"{Megabytes(pack.StoredBytes)} / {Megabytes(pack.Bytes)}" : Megabytes(pack.Bytes);

    private static string Megabytes(long bytes) => $"{Math.Max(1, (int)Math.Round(bytes / 1_000_000.0))} MB";

    private static int Percent(OfflinePack pack) => pack.Bytes == 0 ? 0 : (int)Math.Min(100, 100 * pack.StoredBytes / pack.Bytes);

    private Task Install()
    {
        Audio.PlayClick();
        return Offline.InstallAsync().AsTask();
    }

    private Task Download(OfflinePack pack)
    {
        Audio.PlayClick();
        return Offline.DownloadAsync(pack.Id).AsTask();
    }

    private Task Remove(OfflinePack pack)
    {
        Audio.PlayClick();
        return Offline.RemoveAsync(pack.Id).AsTask();
    }

    public void Dispose() => Offline.Changed -= OnChanged;
}
