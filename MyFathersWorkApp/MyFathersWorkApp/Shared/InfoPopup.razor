@inject AudioService Audio

<div class="popup-overlay">
    @* Parchment (Unity Prompt-panel). Setup and rules drop down from the top, the end of round and of a Generation
       zoom in (entrances in js/transitions.js) *@
    <div class="popup-box mfw-parchment @(GameplayPopUp.PopUpTitle is PopUpTitle.EndOfRound or PopUpTitle.EndOfGeneration ? "zoom" : "drop")">
        <div class="popup-content">
            @if (!string.IsNullOrEmpty(GameplayPopUp.ImageSrc))
            {
                <div class="popup-image-wrapper">
                    <img class="popup-image" src="@FullImagePath" alt="@GameplayPopUp.Title"/>
                </div>
            }

            <div class="popup-text mfw-ink">
                <h2>@GameplayPopUp.Title.InsertImages().ProtectNames(GlobalData).AsMarkup()</h2>
                <p>@GameplayPopUp.Description.InsertImages().ProtectNames(GlobalData).AsMarkup()</p>
                <GuideBox GlobalData="GlobalData"/>
            </div>
        </div>

        <button class="mfw-button green popup-button" @onclick="OnAcceptClicked">
            @GameplayPopUp.ButtonText
        </button>
    </div>
</div>

@code
{
    [Parameter] public GameplayPopup GameplayPopUp { get; set; } = null!;
    [Parameter] public GlobalData    GlobalData    { get; set; } = null!;
    [Parameter] public Action        Refresh       { get; set; } = null!;

    private string FullImagePath => $"./images/setup/{GameplayPopUp.ImageSrc}.png";

    private void OnAcceptClicked()
    {
        Audio.PlayClick();
        GlobalData.RunScenarioAction(() =>
        {
            GlobalData.ActivePopup = null;
            GameplayPopUp.OnClose(GlobalData);
        });
        Refresh();
    }
}