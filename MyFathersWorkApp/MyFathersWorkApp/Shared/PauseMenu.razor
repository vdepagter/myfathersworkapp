@using Newtonsoft.Json
@inject NavigationManager Nav
@inject IJSRuntime        Js
@inject AudioService      Audio

@if (Visible)
{
    <div class="pause-menu-overlay">
        @* Unity PausePopup: the dark Settings Panel, with the game's settings below the buttons *@
        <div class="pause-menu mfw-dark-panel mfw-appear" role="dialog">
            <h2 class="mfw-heading">@GlobalData!.GetLocalizedUITag(GlobalTags.Gameplay_PauseMenu)</h2>

            <div class="pause-buttons">
                <button class="mfw-button green"
                        @onclick="Resume">@GlobalData!.GetLocalizedUITag(GlobalTags.Gameplay_Resume)</button>
                <button class="mfw-button"
                        @onclick="OnReturnToMainMenu">@GlobalData!.GetLocalizedUITag(GlobalTags.Gameplay_ReturnToMainMenu)</button>
            </div>

            <DisplaySettings GlobalData="GlobalData!"/>

            <PlayOptions GlobalData="GlobalData!"/>

            <OfflineEntry GlobalData="GlobalData!"/>

            <div class="mfw-settings-group">
                @if (IsThereAnySavedState)
                {
                    @if (GlobalData!.UI_Localization.Count > 1)
                    {
                        <div class="mfw-setting-row">
                            <label class="mfw-setting-label" for="pause-language">@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Language)</label>
                            <select id="pause-language" value="@GlobalData.Language" @onchange="OnLanguageChanges">
                                @foreach (string lang in GlobalData.UI_Localization.Keys)
                                {
                                    <option value="@lang">@GlobalData.GetLocalizedUITag(lang)</option>
                                }
                            </select>
                        </div>
                    }
                    @* The story follows the menu language when the scenario is translated (AppLanguages.cs); the
                       separate Scenario Language choice was dropped with the Czech translation (Nov 2026) *@
                }

                @* Always shown (not only with a saved game); a change stops the current narration *@
                @if (Audio.Available)
                {
                    <div class="mfw-setting-row">
                        <label class="mfw-setting-label" for="pause-narration">@GlobalData!.GetLocalizedUITag(GlobalTags.Audio_Narration)</label>
                        <select id="pause-narration" value="@Audio.Narration" @onchange="OnNarrationChanged">
                            <option value="@NarrationVoice.Oliver">@GlobalData.GetLocalizedUITag(GlobalTags.Audio_NarrationOliver)</option>
                            <option value="@NarrationVoice.Male">@GlobalData.GetLocalizedUITag(GlobalTags.Audio_NarrationMale)</option>
                            <option value="@NarrationVoice.Female">@GlobalData.GetLocalizedUITag(GlobalTags.Audio_NarrationFemale)</option>
                            <option value="@NarrationVoice.Off">@GlobalData.GetLocalizedUITag(GlobalTags.Audio_NarrationOff)</option>
                        </select>
                    </div>
                }

                @if (Audio.Narration == NarrationVoice.Oliver)
                {
                    <div class="mfw-setting-row">
                        <label class="mfw-setting-label" for="pause-highlight">@GlobalData!.GetLocalizedUITag(GlobalTags.Audio_Highlight)</label>
                        <select id="pause-highlight" value="@Audio.NarrationHighlight" @onchange="e => Audio.SetNarrationHighlight(e.Value?.ToString() ?? string.Empty)">
                            @foreach (string mode in AudioService.HighlightStyles)
                            {
                                <option value="@mode">@GlobalData.GetLocalizedUITag(GlobalTags.Audio_Highlight + "_" + mode)</option>
                            }
                        </select>
                    </div>
                    <div class="mfw-setting-row">
                        <label class="mfw-setting-label" for="pause-scroll">@GlobalData!.GetLocalizedUITag(GlobalTags.Audio_Scroll)</label>
                        <select id="pause-scroll" value="@Audio.NarrationScroll" @onchange="e => Audio.SetNarrationScroll(e.Value?.ToString() ?? string.Empty)">
                            @foreach (string mode in AudioService.ScrollModes)
                            {
                                <option value="@mode">@GlobalData.GetLocalizedUITag(GlobalTags.Audio_Scroll + "_" + mode)</option>
                            }
                        </select>
                    </div>
                }
            </div>

            <VolumeSliders GlobalData="GlobalData!"/>

            <p class="mfw-version">@AppInfo.Version</p>

        </div>
    </div>
}

@code {
    [Parameter] public bool          Visible              { get; set; }
    [Parameter] public EventCallback OnResume             { get; set; }
    [Parameter] public GlobalData?   GlobalData           { get; set; }
    [Parameter] public bool          IsThereAnySavedState { get; set; }

    private Task Resume()
    {
        Audio.PlayClick();
        return OnResume.InvokeAsync();
    }

    private void OnReturnToMainMenu()
    {
        Audio.PlayClick();
        Nav.NavigateTo("");
    }

    private void OnNarrationChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse(e.Value?.ToString(), out NarrationVoice narration)) Audio.SetNarration(narration);
    }

    // The menu language is a device setting (GlobalData.SetLanguageAsync); the reload reopens the game in it, the story
    // too when the scenario is translated
    private async Task OnLanguageChanges(ChangeEventArgs e)
    {
        await GlobalData!.SetLanguageAsync(Js, e.Value!.ToString()!);
        Nav.NavigateTo(Nav.Uri, true);
    }

}