@page "/PlayersScenarioLanguage"
@using MyFathersWorkApp.Shared
@inject NavigationManager Nav
@inject AudioService      Audio
@inject HttpClient        Http
@inject GameOptions       Options

@if (!SKIP_PAGE)
{
<MenuPage Title="@GlobalData.GetLocalizedUITag(GlobalTags.ScenarioLanguage_Title)" OnBack="GoBack" Class="centered">
    <p class="mp-lead">@GlobalData.GetLocalizedUITag(GlobalTags.ScenarioLanguage_Subtitle)</p>

    <div class="mfw-dark-panel mp-panel options">
        <label class="narration-option">
            <b>@GlobalData.GetLocalizedUITag(GlobalTags.Audio_Narration)</b>
            <select value="@Audio.Narration" @onchange="OnNarrationChanged">
                <option value="@NarrationVoice.Female">@GlobalData.GetLocalizedUITag(GlobalTags.Audio_NarrationFemale)</option>
                <option value="@NarrationVoice.Male">@GlobalData.GetLocalizedUITag(GlobalTags.Audio_NarrationMale)</option>
                <option value="@NarrationVoice.Oliver">@GlobalData.GetLocalizedUITag(GlobalTags.Audio_NarrationOliver)</option>
                <option value="@NarrationVoice.Off">@GlobalData.GetLocalizedUITag(GlobalTags.Audio_NarrationOff)</option>
            </select>
        </label>
    </div>

    <div class="mp-actions">
        @foreach (KeyValuePair<string, string> pair in _LocalizationOptions)
        {
            <button class="mfw-button mp-button" @onclick="() => SelectLanguage(pair.Key)">
                @pair.Value
            </button>
        }
    </div>
</MenuPage>
}

@code
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;

    private readonly Dictionary<string, Dictionary<string, string>> _ScenarioLocalizations         = new();
    private readonly Dictionary<string, Dictionary<string, string>> _ScenarioGameplayLocalizations = new();

    private readonly Dictionary<string, string> _LocalizationOptions = new();

    // The page is skipped (owner, 16 Nov 2026): the game starts in the first scenario language straight from the scenario
    // picker. Narration is chosen in Settings and the pause menu, play-along in Settings. Set to false to show it again.
    private static readonly bool SKIP_PAGE = true;

    private void GoBack()
    {
        Audio.PlayClick();
        Nav.NavigateTo("PlayersScenario");
    }

    private void OnNarrationChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse(e.Value?.ToString(), out NarrationVoice narration)) Audio.SetNarration(narration);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await GlobalData.LoadScenarioLanguagesOptionsAsync(Nav, Http, _ScenarioLocalizations, _ScenarioGameplayLocalizations);

        foreach (string localizationId in _ScenarioLocalizations.Keys)
        {
            _LocalizationOptions[localizationId] = GlobalData.GetLocalizedUITag("ScenarioLang_" + localizationId);
        }

        if (SKIP_PAGE && _LocalizationOptions.Count > 0) SelectLanguage(_LocalizationOptions.Keys.First(), false);
    }

    private void SelectLanguage(string key) => SelectLanguage(key, true);

    private void SelectLanguage(string key, bool click)
    {
        if (click) Audio.PlayClick();
        GlobalData.Years      = Years.Early;
        GlobalData.Generation = Generation.First;

        // Skipped page: the story follows the menu language when the scenario is translated (AppLanguages.cs)
        GlobalData.ApplyScenarioLanguage(_ScenarioLocalizations, _ScenarioGameplayLocalizations);
        if (click)
        {
            GlobalData.ScenarioLanguage               = key;
            GlobalData.Scenario_Localization          = _ScenarioLocalizations[key];
            GlobalData.Scenario_Gameplay_Localization = _ScenarioGameplayLocalizations[_ScenarioLocalizations[key]["Gameplay_Lang"]];
        }

        GlobalData.ActiveWindow     = null;
        GlobalData.ActiveHub        = null;
        GlobalData.ActivePopup      = null;
        GlobalData.ActiveInputPopup = null;
        GlobalData.MirrorMode       = Options.MirrorMode; // tester option in Settings (Shared/PlayOptions.razor)
        
        GlobalData.ResetScenarioVars();

        if (!GlobalData.StartScenario())
        {
            Nav.NavigateTo("");
            return;
        }

        Nav.NavigateTo("Gameplay", replace: !click); // skipped page: Back must not land here and start a game again
    }
}
