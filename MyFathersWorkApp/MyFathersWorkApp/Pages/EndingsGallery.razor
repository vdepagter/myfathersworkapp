@page "/EndingsGallery"
@using MyFathersWorkApp.Shared
@using System.Globalization
@inject NavigationManager Nav
@inject IJSRuntime        Js
@inject AudioService      Audio
@inject GalleryService    Gallery

<MenuPage Title="@GlobalData.GetLocalizedUITag(GlobalTags.MainMenu_Gallery)" OnBack="GoBack">
<div class="gallery-container">

    <div class="mp-tabs gallery-tabs" role="tablist">
        <button role="tab" aria-selected="@(_EndingsTab ? "false" : "true")" class="mp-chip" @onclick="() => SelectTab(false)">
            @GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Players)
        </button>
        <button role="tab" aria-selected="@(_EndingsTab ? "true" : "false")" class="mp-chip" @onclick="() => SelectTab(true)">
            @GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Endings)
        </button>
    </div>

    @if (_Data == null)
    {
    }
    else if (!_EndingsTab)
    {
        <div class="players-column">
            <div class="gallery-panel tally-scroll">
                <table class="tally">
                    <thead>
                        <tr>
                            <th class="tally-name-head">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Player)</th>
                            @foreach (ScenarioId scenario in GalleryTrees.Scenarios)
                            {
                                <th class="tally-scenario" title="@GalleryTrees.Name(scenario)">
                                    <div class="tally-cover cover-@((int)scenario)" aria-hidden="true"></div>
                                    <span class="tally-scenario-name">@GalleryTrees.Name(scenario)</span>
                                </th>
                            }
                            <th>@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Wins)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (TallyLine line in Tally())
                        {
                            <tr class="@(line.Family ? "family" : "")">
                                <td class="tally-name">
                                    <b>@line.Name</b>
                                    <small>@line.Sub</small>
                                </td>
                                @foreach (int wins in line.PerScenario)
                                {
                                    <td class="@(wins == 0 ? "zero" : "")">@wins</td>
                                }
                                <td class="tally-wins">@line.Wins</td>
                                <td>
                                    @if (line.Forgettable)
                                    {
                                        string label = GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Forget).FormatWithReplacement(0, line.Name);
                                        <button class="tally-forget" aria-label="@label" title="@label" @onclick="() => Forget(line.Name)">×</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <h2 class="mp-section-title">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_RecentGames)</h2>

            <div class="gallery-panel">
                @if (_Data.Games.Count == 0)
                {
                    <p class="mp-note">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_NoGames)</p>
                }

                @foreach (GalleryGame game in _Data.Games.OrderByDescending(game => game.Date).Take(10))
                {
                    <div class="recent-game">
                        <div>
                            <b>@GalleryTrees.Title(game)</b>
                            <small>@GalleryTrees.Name(game.Scenario) · @FormatDate(game.Date) · @string.Join(", ", game.Players)</small>
                        </div>
                        <span class="recent-winner">@(game.FamilyWinner ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Family) : game.Winner)</span>
                    </div>
                }
            </div>

            <details class="gallery-backup">
                <summary>@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Backup)</summary>
                <p class="mp-note">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_BackupNote)</p>

                <div class="gallery-buttons">
                    <button class="mp-chip" @onclick="Export">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Export)</button>
                    <button class="mp-chip" @onclick="ShowImport">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Import)</button>
                </div>

                @if (_Export != string.Empty)
                {
                    <textarea class="mp-input" readonly>@_Export</textarea>
                    <div class="gallery-buttons">
                        <button class="mp-chip" @onclick="CopyExport">@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_Copy)</button>
                        <button class="mp-chip" @onclick="DownloadExport">@GlobalData.GetLocalizedUITag(GlobalTags.Gameplay_DownloadFile)</button>
                    </div>
                }

                @if (_ShowImport)
                {
                    <textarea class="mp-input" @bind="_ImportText" placeholder="@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_PasteHere)"></textarea>
                    <div class="gallery-buttons">
                        <InputFile OnChange="@LoadImportFile"/>
                        <button class="mp-chip" @onclick="Import">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Import)</button>
                    </div>
                }

                @if (_ImportMessage != string.Empty)
                {
                    <p class="mp-note">@_ImportMessage</p>
                }
            </details>
        </div>
    }
    else
    {
        <div class="scenario-posters">
            @foreach (ScenarioId scenario in GalleryTrees.Scenarios)
            {
                int found = GalleryService.EndingsDone(_Data, scenario).Count;
                <button class="scenario-poster" aria-pressed="@(scenario == _Scenario ? "true" : "false")" @onclick="() => SelectScenario(scenario)">
                    <span class="poster-art cover-@((int)scenario)"></span>
                    <span class="poster-name">@GalleryTrees.Name(scenario)</span>
                    <span class="poster-count">@found / 8</span>
                </button>
            }
        </div>

        int done = GalleryService.EndingsDone(_Data, _Scenario).Count;
        <div class="tree-toolbar">
            <span class="tree-count">
                @GlobalData.GetLocalizedUITag(GlobalTags.Gallery_EndingsCount).FormatWithReplacement(0, done.ToString())
                <span class="pips" aria-hidden="true">
                    @for (int i = 0; i < 8; i++)
                    {
                        <i class="@(i < done ? "on" : "")"></i>
                    }
                </span>
            </span>
            <button class="mp-chip" @onclick="ToggleShowAll">
                @GlobalData.GetLocalizedUITag(_ShowAll ? GlobalTags.Gallery_HideSpoilers : GlobalTags.Gallery_ShowAll)
            </button>
        </div>

        <div class="gallery-panel">
            <div class="endings-map" id="gallery-map">
                <svg class="map-links" aria-hidden="true"></svg>
                @for (int depth = 0; depth < 4; depth++)
                {
                    <div class="map-head" style="grid-column: @(depth + 1)">@LevelName(depth)</div>
                }

                @foreach (TreeRow row in TreeRows())
                {
                    <div class="map-cell @(row.Lit ? "lit" : "")" style="--depth: @row.Node.Depth; grid-column: @(row.Node.Depth + 1); grid-row: @(row.Row) / span @(row.Span);"
                         data-i="@row.Index" data-parent="@row.Parent" data-lit="@(row.Lit ? "1" : "0")">
                        @if (row.FirstOfLevel)
                        {
                            <span class="map-level">@LevelName(row.Node.Depth)</span>
                        }

                        @if (!row.Known)
                        {
                            <button class="plaque locked @(row.Node.IsEnding ? "" : "branch")" @onclick="() => Reveal(row.Key)">
                                @if (row.Node.IsEnding)
                                {
                                    <span class="mark locked" aria-hidden="true">?</span>
                                }
                                <span class="plaque-text">
                                    <b>@row.Label</b>
                                    <small>@row.Status</small>
                                </span>
                            </button>
                        }
                        else
                        {
                            <div class="plaque @(row.Node.IsEnding ? "" : "branch") @(row.Lit && !row.Node.IsEnding ? "lit" : "") @(row.Played ? "played" : "")">
                                @if (row.Node.IsEnding)
                                {
                                    string mark = row.Played ? "played" : row.Ticked ? "ticked" : "open";
                                    <span class="mark @mark" aria-hidden="true">@(row.Played ? "★" : row.Ticked ? "✓" : "")</span>
                                }
                                <span class="plaque-text">
                                    <b>@row.Label</b>
                                    <small>@row.Status</small>
                                    @if (row.Node.SameAs != string.Empty)
                                    {
                                        <span class="plaque-dup">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_AlsoElsewhere).FormatWithReplacement(0, row.Node.SameAs)</span>
                                    }
                                </span>
                                @if (row.Node.IsEnding && !row.Played)
                                {
                                    string label = GlobalData.GetLocalizedUITag(row.Ticked ? GlobalTags.Gallery_Untick : GlobalTags.Gallery_TickOff).FormatWithReplacement(0, row.Label);
                                    <button class="tree-tick @(row.Ticked ? "ticked" : "")" aria-pressed="@(row.Ticked ? "true" : "false")" aria-label="@label" title="@label"
                                            @onclick="() => ToggleTick(row.Node.Ending, !row.Ticked)">@(row.Ticked ? "✓" : "")</button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="gallery-key">
            <span><i class="mark played" aria-hidden="true">★</i>@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_KeyPlayed)</span>
            <span><i class="mark ticked" aria-hidden="true">✓</i>@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_TickedByHand)</span>
            <span><i class="mark open" aria-hidden="true"></i>@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_KeyOpen)</span>
            <span><i class="mark locked" aria-hidden="true">?</i>@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_KeyLocked)</span>
        </div>
        <p class="mp-note gallery-legend">@GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Legend)</p>
    }
</div>
</MenuPage>

@code
{
    [CascadingParameter] private GlobalData GlobalData { get; set; } = null!;

    private record TallyLine(string Name, string Sub, int[] PerScenario, int Wins, bool Family, bool Forgettable);

    // One plaque of the endings map. Row / Span: its place in the map grid (one grid row per ending below it); Parent: the
    // index of the branch it hangs from (-1 for the first branch), for the lines drawn by js/gallery.js
    private record TreeRow(GalleryNode Node, int Index, string Key, string Label, string Status, bool Known, bool Lit, bool Played, bool Ticked,
                           int Parent, int Row, int Span, bool FirstOfLevel);

    private GalleryData? _Data;
    private bool         _EndingsTab;
    private ScenarioId   _Scenario = ScenarioId.CostOfDisease;
    private bool         _ShowAll;
    private string       _Export        = string.Empty;
    private bool         _ShowImport;
    private string       _ImportText    = string.Empty;
    private string       _ImportMessage = string.Empty;

    private readonly HashSet<string> _Revealed = [];

    protected override async Task OnInitializedAsync()
    {
        _Data = await Gallery.GetAsync();

        // Open the endings of the scenario played last
        GalleryGame? last = _Data.Games.OrderByDescending(game => game.Date).FirstOrDefault();
        if (last != null) _Scenario = last.Scenario;
    }

    private static string FormatDate(DateTime date) => date.ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    private IEnumerable<TallyLine> Tally()
    {
        GalleryData    data  = _Data!;
        HashSet<string> names = data.Players.Select(player => player.Name).ToHashSet();
        names.UnionWith(data.Games.SelectMany(game => game.Players));

        int[] PerScenario(Func<GalleryGame, bool> won) => GalleryTrees.Scenarios.Select(scenario => data.Games.Count(game => game.Scenario == scenario && won(game))).ToArray();

        List<TallyLine> lines = names.Select(name =>
                                     {
                                         int[] perScenario = PerScenario(game => !game.FamilyWinner && game.Winner == name);
                                         int   played      = data.Games.Count(game => game.Players.Contains(name));
                                         return new TallyLine(name,
                                                              GlobalData.GetLocalizedUITag(GlobalTags.Gallery_GamesPlayed).FormatWithReplacement(0, played.ToString()),
                                                              perScenario, perScenario.Sum(), false, data.Players.Any(player => player.Name == name));
                                     })
                                     .OrderByDescending(line => line.Wins)
                                     .ThenBy(line => line.Name, StringComparer.CurrentCultureIgnoreCase)
                                     .ToList();

        int[] family = PerScenario(game => game.FamilyWinner);
        if (family.Sum() > 0)
        {
            lines.Add(new TallyLine(GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Family), GlobalData.GetLocalizedUITag(GlobalTags.Gallery_FamilyNote),
                                    family, family.Sum(), true, false));
        }

        return lines;
    }

    private IEnumerable<TreeRow> TreeRows()
    {
        GalleryData   data    = _Data!;
        GalleryNode[] tree    = GalleryTrees.Tree(_Scenario);
        HashSet<int>  done    = GalleryService.EndingsDone(data, _Scenario);
        List<int>     reached = GalleryService.Entry(data.Reached, _Scenario);
        List<int>     ticked  = GalleryService.Entry(data.Ticked, _Scenario);
        int           row     = 2; // row 1 holds the level names

        for (int i = 0; i < tree.Length; i++)
        {
            GalleryNode node = tree[i];
            string      key  = $"{_Scenario}:{i}";
            bool        lit;

            // Endings below this node (the grid rows it spans)
            int span = node.IsEnding ? 1 : 0;
            for (int j = i + 1; !node.IsEnding && j < tree.Length && tree[j].Depth > node.Depth; j++) span += tree[j].IsEnding ? 1 : 0;

            if (node.IsEnding) lit = done.Contains(node.Ending);
            else
            {
                // A branch is lit when it was reached in play or an ending below it is done
                lit = reached.Contains(node.HubId);
                for (int j = i + 1; !lit && j < tree.Length && tree[j].Depth > node.Depth; j++) lit = tree[j].IsEnding && done.Contains(tree[j].Ending);
            }

            int parent = -1;
            for (int j = i - 1; j >= 0 && parent < 0; j--) if (tree[j].Depth < node.Depth) parent = j;

            bool         known      = lit || _ShowAll || _Revealed.Contains(key);
            GalleryGame? lastPlayed = node.IsEnding ? data.Games.Where(game => game.Scenario == _Scenario && game.Ending == node.Ending).MaxBy(game => game.Date) : null;
            bool         isTicked   = node.IsEnding && ticked.Contains(node.Ending);

            string label = !known       ? GlobalData.GetLocalizedUITag(node.IsEnding ? GlobalTags.Gallery_LockedEnding : GlobalTags.Gallery_LockedBranch)
                         : lastPlayed != null && lastPlayed.Title != string.Empty ? GalleryTrees.Title(lastPlayed)
                         : node.Label;

            string status = !known            ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Reveal)
                          : lit && !node.IsEnding ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Reached)
                          : lastPlayed != null ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Played).FormatWithReplacement(0, FormatDate(lastPlayed.Date)) + " · " +
                                                 (lastPlayed.FamilyWinner ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_SharedWin)
                                                  : lastPlayed.Winner != string.Empty ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_WonBy).FormatWithReplacement(0, lastPlayed.Winner)
                                                  : string.Empty)
                          : isTicked           ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_TickedByHand)
                          : GlobalData.GetLocalizedUITag(GlobalTags.Gallery_NotReached);
            status = status.TrimEnd(' ', '·');

            // The level name shows above the first plaque of each level on narrow screens (the map columns have it in their heads)
            bool firstOfLevel = i == 0 || tree[i - 1].Depth < node.Depth;

            yield return new TreeRow(node, i, key, label, status, known, lit, lastPlayed != null, isTicked, parent, row, span, firstOfLevel);
            if (node.IsEnding) row++;
        }
    }

    private string LevelName(int depth) => depth < 3
                                               ? GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Generation).FormatWithIndex(0, depth)
                                               : GlobalData.GetLocalizedUITag(GlobalTags.Gallery_Ending);

    // Draws the lines between the plaques of the endings map (wide screens) after every render of the Endings tab
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_Data == null || !_EndingsTab) return;

        try
        {
            await Js.InvokeVoidAsync("mfwGallery.links", "gallery-map");
        }
        catch (JSException e)
        {
            Console.WriteLine($"Gallery: could not draw the map lines ({e.Message})");
        }
    }

    private void GoBack()
    {
        Audio.PlayClick();
        Nav.NavigateTo("");
    }

    private void SelectTab(bool endings)
    {
        Audio.PlayClick();
        _EndingsTab = endings;
    }

    private void SelectScenario(ScenarioId scenario)
    {
        Audio.PlayClick();
        _Scenario = scenario;
    }

    private void ToggleShowAll()
    {
        Audio.PlayClick();
        _ShowAll = !_ShowAll;
    }

    private void Reveal(string key)
    {
        Audio.PlayClick();
        _Revealed.Add(key);
    }

    private async Task ToggleTick(int ending, bool ticked)
    {
        Audio.PlayClick();
        await Gallery.SetTickedAsync(_Scenario, ending, ticked);
    }

    private async Task Forget(string name)
    {
        Audio.PlayClick();
        await Gallery.ForgetPlayerAsync(name);
    }

    private async Task Export()
    {
        Audio.PlayClick();
        _ShowImport    = false;
        _ImportMessage = string.Empty;
        _Export        = await Gallery.ExportAsync();
    }

    private async Task CopyExport()
    {
        Audio.PlayClick();
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", _Export);
    }

    private async Task DownloadExport()
    {
        Audio.PlayClick();
        await Js.InvokeVoidAsync("BlazorDownloadFile", "MyFathersWorkEndingsGallery.txt", "text/plain;charset=utf-8", _Export);
    }

    private void ShowImport()
    {
        Audio.PlayClick();
        _Export        = string.Empty;
        _ImportMessage = string.Empty;
        _ShowImport    = true;
    }

    private async Task LoadImportFile(InputFileChangeEventArgs e)
    {
        using StreamReader reader = new StreamReader(e.File.OpenReadStream(1024 * 1024));
        _ImportText = (await reader.ReadToEndAsync()).Trim();
    }

    private async Task Import()
    {
        Audio.PlayClick();
        if (string.IsNullOrWhiteSpace(_ImportText)) return;

        bool ok = await Gallery.ImportAsync(_ImportText);
        _ImportMessage = GlobalData.GetLocalizedUITag(ok ? GlobalTags.Gallery_ImportDone : GlobalTags.Gallery_ImportFailed);
        if (!ok) return;

        _ShowImport = false;
        _ImportText = string.Empty;
    }
}
